# Copy to .env and fill in at least one free LLM key to enable AI review.
# With no key set, DesignLoop still runs end to end and gives deterministic feedback only.

# Providers are tried in this order; any without a key are skipped.
LLM_PROVIDERS=gemini,groq,openrouter

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free quotas are per model: list several, comma-separated, and each becomes its own fallback.
GEMINI_MODEL=gemini-3.6-flash,gemini-flash-latest

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (free models end in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Any other OpenAI-compatible endpoint, e.g. a local Ollama server.
# Add "custom" to LLM_PROVIDERS to use it.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
# json_object (default) or json_schema
CUSTOM_LLM_OUTPUT_MODE=

# Server (defaults shown)
PORT=4000
# DATABASE_PATH=server/data/designloop.db
LLM_TIMEOUT_MS=45000
EVALUATION_LEASE_MS=60000
WORKER_POLL_MS=2000
