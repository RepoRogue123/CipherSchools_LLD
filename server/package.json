{
  "name": "@designloop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/main.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:llm": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env scripts/smoke-llm.ts",
    "calibrate": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env scripts/calibrate.ts"
  },
  "dependencies": {
    "@designloop/shared": "0.1.0",
    "express": "^5.2.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
